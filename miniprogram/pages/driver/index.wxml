<view class="screen"><view class="brand">DRIVER WORKSPACE</view><view class="title">{{en?'Ready for the next trip.':'每一程，安心出发。'}}</view><view class="subtitle">{{en?'Tasks, dispatch and bilingual assistance':'今日任务、调度通知与司乘沟通'}}</view><view class="panel"><view class="heading">{{en?'Departure tasks':'排班与调度任务'}}</view><view class="record" wx:for="{{tasks}}" wx:key="id"><view class="brand">{{item.date}} {{item.time}} / {{item.status==='pending'?(en?'Pending':'待确认'):item.status==='accepted'?(en?'Accepted':'已确认'):(en?'Completed':'已完成')}}</view><view class="record-title">{{en?item.en:item.title}}</view><view class="row"><button class="key" bindtap="speakTask">▶ {{en?'Read task':'播报任务'}}</button><button wx:if="{{item.status!=='completed'}}" class="key dark" bindtap="accept" data-id="{{item.id}}" data-status="{{item.status==='pending'?'accepted':'completed'}}">{{item.status==='pending'?(en?'Accept':'确认任务'):(en?'Complete':'完成任务')}}</button></view></view><view wx:if="{{!tasks.length}}" class="empty">{{en?'No tasks':'暂无任务'}}</view><view class="footnote">{{en?'Keep this page open for automatic task and departure audio alerts.':'保持页面在前台，自动播报新任务和发车提醒。'}}</view></view><view class="panel"><view class="heading">{{en?'Bilingual assistance':'双语沟通卡'}}</view><view class="phrase" wx:for="{{phrases}}" wx:key="index" data-index="{{index}}" bindtap="phrase">{{item[0]}} ▶<view class="muted">{{item[1]}}</view></view></view><view class="panel"><view class="heading">{{en?'Report an issue':'异常上报'}}</view><picker range="{{vehicles}}" range-key="name" bindchange="vehicle" value="{{vehicleIndex||0}}"><view class="field key">{{vehicles[vehicleIndex||0].name||'—'}} ▾</view></picker><view class="row"><button class="key" data-kind="{{en?'Vehicle fault':'车辆故障'}}" bindtap="quick">{{en?'Vehicle fault':'车辆故障'}} ↗</button><button class="key" data-kind="{{en?'Item found':'物品拾获'}}" bindtap="quick">{{en?'Item found':'物品拾获'}} ↗</button></view><view class="footnote">{{en?'Add details below if needed.':'可在下方补充详细情况。'}}</view><form bindsubmit="report"><view class="field"><view class="field-label">{{en?'Type':'异常类型'}}</view><input name="type" value="{{en?'Other issue':'其他异常'}}" maxlength="80"/></view><view class="field"><textarea name="content" maxlength="2000" placeholder="{{en?'Describe the issue':'请描述异常情况'}}"/></view><button class="key dark" form-type="submit">{{en?'Send to dispatch':'上报调度中心'}}</button></form></view><view class="panel"><view class="heading">{{en?'My reports':'我的上报'}}</view><view wx:for="{{reports}}" wx:key="id" class="record"><view class="pill">{{item.status==='open'?(en?'Submitted':'已提交'):item.status==='processing'?(en?'In progress':'处理中'):(en?'Closed':'已办结')}}</view><view class="record-title">{{item.title}}</view><view class="record-body">{{item.content}}</view><view class="record-reply" wx:if="{{item.reply}}">{{item.reply}}</view></view><view wx:if="{{!reports.length}}" class="empty">{{en?'No reports yet':'暂无上报'}}</view></view></view>
