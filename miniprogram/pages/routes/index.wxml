<view class="screen"><view class="brand">ROUTES &amp; TIMETABLE</view><view class="title">{{en?'Know every stop.':'每一站，都心中有数。'}}</view><view class="subtitle">{{en?'Schedules and saved routes':'全线路时刻表与常用路线'}}</view><view wx:if="{{demo}}" class="demo">{{en?'Demo schedules, pending confirmation.':'演示时刻表，实际运营信息待确认。'}}</view><view class="panel" wx:for="{{routes}}" wx:key="id" wx:for-item="r"><view class="row"><view class="heading">{{en?r.en:r.name}}</view><view data-id="{{r.id}}" bindtap="favorite">{{r.favorite?'★':'☆'}}</view></view><view class="muted">{{r.first}} — {{r.last}} · {{en?'Every':'约'}} {{r.interval}} {{en?'min':'分钟 / 班'}}</view><view class="stop" wx:for="{{r.stops}}" wx:key="key" data-route-id="{{r.id}}" data-stop-id="{{item.id}}" bindtap="select">{{en?item.en:item.name}} ↗<view class="muted">{{en?item.name:item.en}}</view></view><view class="key" data-id="{{r.id}}" bindtap="expand">{{en?'Departure times':'查看发车时刻'}} ▾</view><view wx:if="{{expanded===r.id}}" class="times"><text class="time" wx:for="{{r.times}}" wx:key="*this">{{item}}</text></view></view><view wx:if="{{!routes.length}}" class="empty">{{en?'No routes yet':'暂无线路'}}</view></view>
