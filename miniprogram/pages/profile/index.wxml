<view class="screen"><view class="top"><view class="brand">YOUR EVERYDAY</view><view class="language" bindtap="changeLang">{{en?'中文':'EN'}}</view></view><view class="title">{{en?'Your everyday, in one place.':'常用的，都在这里。'}}</view><view class="subtitle">{{en?'Saved routes and service requests':'收藏线路与我的服务记录'}}</view><view wx:if="{{!me}}" class="panel"><view class="empty">{{en?'Sign in to view your records':'登录后查看收藏与服务进度'}}</view><button class="key dark" bindtap="login">{{demo?(en?'Demo sign in':'演示登录'):(en?'Sign in with WeChat':'微信登录')}}</button></view><block wx:else><view class="panel"><view class="row"><view class="heading">{{en?'Saved routes':'常用线路'}}</view><view class="pill" bindtap="logout">{{en?'Sign out':'退出登录'}}</view></view><view wx:for="{{favorites}}" wx:key="id" class="phrase" data-id="{{item.id}}" bindtap="select">★ {{en?item.en:item.name}} ↗</view><view wx:if="{{!favorites.length}}" class="empty">{{en?'Tap a star on a route to save it.':'还没有收藏，在线路页点亮星标即可添加。'}}</view></view><view class="panel"><view class="heading">{{en?'My requests':'我的服务记录'}}</view><view wx:for="{{records}}" wx:key="id" class="record"><view class="pill">{{item.statusLabel}}</view><view class="record-title">{{item.title}}</view><view class="record-body">{{item.content}}</view><view wx:if="{{item.reply}}" class="record-reply">{{en?'Reply: ':'处理回复：'}}{{item.reply}}</view><view class="footnote">{{item.time}}</view></view><view wx:if="{{!records.length}}" class="empty">{{en?'No requests yet':'暂无服务记录'}}</view></view></block><view class="panel"><view class="heading">{{en?'Driver workspace':'司机工作台'}}</view><button wx:if="{{role==='driver'}}" class="key" bindtap="goDriver">{{en?'Open workspace':'进入工作台'}} ↗</button><form wx:else bindsubmit="driverLogin"><view class="field"><view class="field-label">{{en?'Driver ID':'司机编号'}}</view><input name="driverId" value="d1"/></view><view class="field"><view class="field-label">{{en?'Work password (not required in demo)':'工作密码（演示环境免填）'}}</view><input name="password" password/></view><button class="key" form-type="submit">{{en?'Driver sign in':'司机登录'}} ↗</button></form><view class="footnote">{{en?'Administrators use the desktop operations console.':'调度管理员请在电脑端管理后台维护资料、处理记录和导出数据。'}}</view></view><view wx:if="{{development}}" class="panel"><view class="eyebrow">DEVELOPMENT</view><view class="heading">{{en?'Backend connection':'后端连接'}}</view><view class="field"><view class="field-label">{{en?'API address':'接口地址'}}</view><input value="{{connectionInput}}" bindinput="changeConnection" placeholder="https://example.com/api"/></view><button class="key" bindtap="connectBackend" loading="{{connectionChecking}}" disabled="{{connectionChecking}}">{{en?'Connect and check':'连接并检测'}}</button><button class="key" bindtap="resetConnection">{{en?'Restore default address':'恢复默认地址'}}</button><view class="footnote">{{connectionStatus}}</view><view class="footnote" selectable="{{true}}">{{connectionCandidatesText}}</view><view class="footnote">{{en?'Phones must use the computer LAN address on the same Wi-Fi/hotspot. Enable 开发调试 from the top-right menu and allow WeChat local network on iPhone.':'真机需与电脑同一 Wi-Fi/热点；手机微信右上角“…”打开“开发调试”；iPhone 需允许微信访问本地网络。'}}</view></view></view>
