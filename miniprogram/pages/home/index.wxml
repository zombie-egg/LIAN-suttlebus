<view class="screen"><view class="top"><view class="brand">LI’AN ONE / 黎安一站式</view><view class="language" bindtap="switchLang">{{en?'中文':'EN'}}</view></view><view wx:if="{{demo}}" class="demo">DEMO · {{en?'Sample data. Do not use for actual travel.':'演示车辆、站点与线路，请勿用于实际出行。'}}</view><view class="title">{{en?'Your next trip, at ease.':'下一程，从容出发。'}}</view><view class="subtitle">{{en?'Less waiting. Your everyday campus connection.':'查一辆车，少等一会。连接校园里的每一个日常。'}}</view><view wx:if="{{loading}}" class="empty">{{en?'Connecting…':'正在连接园区服务…'}}</view><view wx:if="{{error}}" class="demo" bindtap="refresh">{{error}} · {{en?'Tap to retry':'点击重试'}}</view><view wx:if="{{error && development}}" class="panel"><view class="eyebrow">真机联调 / DEVICE</view><view class="record-body" selectable="{{true}}">{{connectionAddress}}</view><view class="record-body" selectable="{{true}}">{{errorDetail}}</view><view class="record-body" selectable="{{true}}">手机浏览器自测：{{healthAddress}}</view><button class="key" bindtap="refresh">重新检测连接</button><view class="footnote" selectable="{{true}}">{{connectionCandidatesText}}</view><view class="footnote">1. 手机与电脑同一 Wi-Fi/热点；2. 电脑终端保持 npm run dev；3. 手机微信右上角“…”→“开发调试”；4. iPhone 设置→微信→本地网络 打开。</view></view><view wx:if="{{noRoutes}}" class="empty">{{en?'Routes are being prepared.':'线路信息正在准备中。'}}</view><block wx:if="{{route}}"><view class="panel"><view class="eyebrow">01 / {{en?'LIVE ARRIVAL':'实时候车'}}</view><view class="heading">{{en?'Where is your shuttle?':'你的摆渡车，到哪了？'}}</view><view class="selectors"><picker class="picker" range="{{routes}}" range-key="label" value="{{routeIndex}}" bindchange="changeRoute"><view class="caption">{{en?'ROUTE':'选择线路'}}</view><view class="value">{{en?route.en:route.name}} ▾</view></picker><picker class="picker" range="{{stops}}" range-key="label" value="{{stopIndex}}" bindchange="changeStop"><view class="caption">{{en?'YOUR STOP':'候车站点'}}</view><view class="value">{{stop.label}} ▾</view></picker></view><view class="ticket"><view class="row"><text>{{stop.label}}</text><text class="eyebrow">{{en?'EST. ARRIVAL':'预计到站'}}</text></view><view class="row"><view class="eta" wx:if="{{hasEta}}">{{eta}}<text class="eta-unit"> {{en?'min':'分钟'}}</text></view><view class="heading" wx:else>{{en?'Awaiting GPS':'等待可靠定位'}}</view><view class="muted">{{next?next.name:(en?'No reliable estimate':'暂无可靠预测')}}</view></view><view class="ticket-bottom row"><text>{{route.first}} — {{route.last}}</text><text>{{en?'Every':'约'}} {{route.interval}} {{en?'min':'分钟 / 班'}}</text></view></view><view class="row"><button class="key dark grow" bindtap="remind">{{reminder?(en?'Reminder on ✓':'提醒已开启 ✓'):(en?'Remind me':'到站提醒我')}}</button><button class="key" bindtap="favorite">☆ {{en?'Save':'收藏'}}</button></view><view class="footnote">{{en?'Foreground alert + bilingual audio · Estimates may vary.':'前台弹窗 + 双语语音 · 到站时间仅供参考'}}</view></view><view class="panel"><view class="row"><view class="heading">{{en?'Campus travel map':'园区出行地图'}}</view><view class="pill">{{demo?'DEMO':'LIVE'}}</view></view><map class="map" latitude="{{lat}}" longitude="{{lng}}" markers="{{markers}}" polyline="{{polyline}}" scale="15"/><view class="footnote">{{en?'Location over 90s old is excluded from estimates.':'定位超过90秒未更新后停止到站预测。'}}</view></view></block><view class="links"><view class="link" data-page="routes" bindtap="go">{{en?'Routes ↗':'线路时刻 ↗'}}<view class="muted">{{en?'Know every stop':'每一站心中有数'}}</view></view><view class="link" data-page="service" bindtap="go">{{en?'Services ↗':'便民服务 ↗'}}<view class="muted">{{en?'Lost & found':'失物招领与反馈'}}</view></view></view><view class="panel" wx:for="{{notices}}" wx:key="id"><view class="pill">{{en?'NOTICE':'出行公告'}}</view><view class="record-title">{{item.label}}</view><view class="record-body">{{item.body}}</view></view><view class="heading">{{en?'Before you ride':'候车小指南'}}</view><view class="cabinet"><view class="file-card" data-index="0" bindtap="faq"><view class="file-title">Q.01 {{en?'How do estimates work?':'到站预测如何计算？'}} <text>{{faq===0?'−':'+'}}</text></view><view wx:if="{{faq===0}}" class="file-body">{{en?'Ordered route distance and recent speed. Estimates stop when telemetry is stale.':'按线路顺序、车辆最新定位和速度估算，定位过期即停止预测，请以现场情况为准。'}}</view></view><view class="file-card" data-index="1" bindtap="faq"><view class="file-title">Q.02 {{en?'Background reminders?':'提醒需要保持页面打开吗？'}} <text>{{faq===1?'−':'+'}}</text></view><view wx:if="{{faq===1}}" class="file-body">{{en?'Yes. Keep this page open for foreground alerts and bilingual audio.':'需要。请保持本页面在前台，以接收到站弹窗和双语语音。本期不支持后台持续提醒。'}}</view></view><view class="cabinet-front">LI’AN · {{en?'TRAVEL NOTES':'出行指南'}} ▰</view></view><view class="footer">LI’AN ONE · PUBLIC SERVICE · PHASE 01</view></view>
