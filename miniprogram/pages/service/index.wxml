<view class="screen"><view class="brand">HERE TO HELP</view><view class="title">{{en?'Here for the little things.':'小事，也有人在意。'}}</view><view class="subtitle">{{en?'Lost & found and service suggestions':'失物招领与服务建议，每一件都有回应。'}}</view><view class="tabs"><view class="tab {{kind==='feedback'?'active':''}}" data-kind="feedback" bindtap="tab">{{en?'Feedback':'建议反馈'}}</view><view class="tab {{kind==='lost'?'active':''}}" data-kind="lost" bindtap="tab">{{en?'Lost & found':'失物招领'}}</view></view><view class="panel"><view class="heading">{{kind==='lost'?(en?'Report a lost item':'提交失物信息'):(en?'Share a suggestion':'说说你的建议')}}</view><form bindsubmit="submit"><view class="field"><view class="field-label">{{en?'Title':'标题'}}</view><input name="title" maxlength="80" placeholder="{{en?'Briefly describe the issue':'简单描述需要帮助的事情'}}" value="{{formKey?'':''}}"/></view><view class="field"><view class="field-label">{{en?'Stop / location':'站点 / 地点'}}</view><input name="place" maxlength="100" value="{{formKey?'':''}}"/></view><view class="field"><view class="field-label">{{en?'Details (contact visible only to staff)':'详细描述（联系方式仅管理员可见）'}}</view><textarea name="content" maxlength="2000" value="{{formKey?'':''}}"/></view><button class="key dark" form-type="submit" loading="{{busy}}" disabled="{{busy}}">{{en?'Submit request':'提交信息'}} ↗</button></form></view><view class="panel" wx:if="{{kind==='lost'}}"><view class="heading">{{en?'Found items':'待认领物品'}}</view><view class="record" wx:for="{{items}}" wx:key="id"><view class="pill">{{en?'FOUND':'招领中'}}</view><view class="record-title">{{en?(item.en||item.title):item.title}}</view><view class="record-body">{{en?(item.contentEn||item.content):item.content}}</view><view class="muted">{{item.place}}</view><button class="key" data-id="{{item.id}}" bindtap="claim">{{en?'Claim item':'申请认领'}} ↗</button></view><view wx:if="{{!items.length}}" class="empty">{{en?'No found items':'暂无招领信息'}}</view></view><view class="footnote">{{en?'Requests are reviewed by staff. Track responses in My requests.':'信息提交后由管理人员审核处理，可在“我的”中查看回复。'}}</view></view>
