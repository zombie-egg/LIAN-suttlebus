{
  "name": "lian-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:web\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check:mini": "node scripts/check-mini.cjs",
    "mini:connect": "node scripts/mini-connect.mjs",
    "demo:phone": "node scripts/phone-demo.mjs",
    "demo:tunnel": "node scripts/tunnel.mjs",
    "demo:web": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "icons:mini": "node scripts/make-tabbar-icons.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
